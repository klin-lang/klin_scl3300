module klin_scl3300

/// 32-bit SPI, Mode 0, MSB first, ≤4 MHz. Off-frame: MISO is the previous command.
/// The app owns CS (low for 32 clocks, high ≥10 µs between frames).
pub struct Wire {
    ctx: *mut u8
    xfer: fn(*mut u8,i32):i32
    delay_ms: fn(*mut u8,i32):void
}

pub struct Dev {
    wire: Wire
    mode: i32
}

/// One consistent sample (datasheet: read the block together). Raw 16-bit words.
pub struct Sample {
    acc_x: i32
    acc_y: i32
    acc_z: i32
    sto: i32
    temp: i32
    ang_x: i32
    ang_y: i32
    ang_z: i32
    status: i32
    whoami: i32
    crc_ok: bool
    rs_ok: bool
}

fn xfer(dev: Dev, word: i32): i32 {
    let f = dev.wire.xfer
    return f(dev.wire.ctx, word)
}

fn delay_ms(dev: Dev, ms: i32) {
    let f = dev.wire.delay_ms
    f(dev.wire.ctx, ms)
}

fn and_ok(prev: bool, frame: i32): bool {
    if prev {
        if frame_crc_ok(frame) {
            return frame_rs_ok(frame)
        }
    }
    return false
}

fn start(dev: Dev) {
    delay_ms(dev, 1)
    xfer(dev, cmd_bank0())
    xfer(dev, cmd_sw_reset())
    delay_ms(dev, 1)
    xfer(dev, mode_cmd(dev.mode))
    xfer(dev, cmd_ena_ang())
    delay_ms(dev, 100)
    xfer(dev, cmd_rd_stat())
    xfer(dev, cmd_rd_stat())
    xfer(dev, cmd_rd_stat())
    xfer(dev, cmd_whoami())
    xfer(dev, cmd_whoami())
}

fn read16(dev: Dev, cmd: i32): i32 {
    xfer(dev, cmd_bank0())
    xfer(dev, cmd)
    return frame_data(xfer(dev, cmd))
}

/// SW reset + mode + enable angles. Caller must wait ≥1 ms after power-up first.
pub fn attach(wire: Wire, mode: i32): Dev {
    let dev = Dev{ wire: wire, mode: clamp_mode(mode) }
    start(dev)
    return dev
}

/// Same sequence as `attach`, keeping the current mode.
pub fn (dev: Dev) reset() {
    start(dev)
}

/// Change mode `1..=4` (else 4) and write it to the chip.
pub fn (mut dev: Dev) set_mode(mode: i32) {
    let m = clamp_mode(mode)
    let send = dev.wire.xfer
    send(dev.wire.ctx, mode_cmd(m))
    dev.mode = m
}

pub fn (dev: Dev) connected(): bool {
    return dev.whoami() == whoami_id()
}

pub fn (dev: Dev) err_flag1(): i32 {
    return read16(dev, cmd_rd_err1())
}

pub fn (dev: Dev) err_flag2(): i32 {
    return read16(dev, cmd_rd_err2())
}

pub fn (dev: Dev) command_reg(): i32 {
    return read16(dev, cmd_rd_cmd())
}

pub fn (dev: Dev) cur_bank(): i32 {
    return read16(dev, cmd_rd_bank())
}

/// 32-bit factory serial: `SERIAL2 << 16 | SERIAL1` (Arduino `getSerialNumber`).
pub fn (dev: Dev) serial(): i32 {
    xfer(dev, cmd_bank1())
    xfer(dev, cmd_rd_ser1())
    let lo = frame_data(xfer(dev, cmd_rd_ser2()))
    let hi = frame_data(xfer(dev, cmd_bank0()))
    return word32(hi, lo)
}

pub fn (dev: Dev) whoami(): i32 {
    xfer(dev, cmd_bank0())
    xfer(dev, cmd_whoami())
    let frame = xfer(dev, cmd_whoami())
    return frame_data(frame)
}

/// Acc / STO / temp / angles / status / WHOAMI. Off-frame pipeline like the datasheet.
pub fn (dev: Dev) read(): Sample {
    let mut ok = true
    xfer(dev, cmd_bank0())
    xfer(dev, cmd_rd_acc_x())
    let f_ax = xfer(dev, cmd_rd_acc_y())
    ok = and_ok(ok, f_ax)
    let f_ay = xfer(dev, cmd_rd_acc_z())
    ok = and_ok(ok, f_ay)
    let f_az = xfer(dev, cmd_rd_sto())
    ok = and_ok(ok, f_az)
    let f_sto = xfer(dev, cmd_rd_temp())
    ok = and_ok(ok, f_sto)
    let f_temp = xfer(dev, cmd_rd_ang_x())
    ok = and_ok(ok, f_temp)
    let f_angx = xfer(dev, cmd_rd_ang_y())
    ok = and_ok(ok, f_angx)
    let f_angy = xfer(dev, cmd_rd_ang_z())
    ok = and_ok(ok, f_angy)
    let f_angz = xfer(dev, cmd_rd_stat())
    ok = and_ok(ok, f_angz)
    let f_stat = xfer(dev, cmd_whoami())
    ok = and_ok(ok, f_stat)
    let f_who = xfer(dev, cmd_whoami())
    ok = and_ok(ok, f_who)
    return Sample{ acc_x: sign16(frame_data(f_ax)), acc_y: sign16(frame_data(f_ay)), acc_z: sign16(frame_data(f_az)), sto: sign16(frame_data(f_sto)), temp: sign16(frame_data(f_temp)), ang_x: sign16(frame_data(f_angx)), ang_y: sign16(frame_data(f_angy)), ang_z: sign16(frame_data(f_angz)), status: frame_data(f_stat), whoami: frame_data(f_who), crc_ok: ok, rs_ok: ok }
}

pub fn (dev: Dev) power_down() {
    xfer(dev, cmd_bank0())
    xfer(dev, cmd_power_down())
}

/// Wake uses the same MOSI word as mode 1 (`0xB400001F`).
pub fn (dev: Dev) wake() {
    xfer(dev, cmd_mode1())
}

pub fn (s: Sample) ok(): bool {
    if s.crc_ok {
        if s.rs_ok {
            return s.whoami == whoami_id()
        }
    }
    return false
}
